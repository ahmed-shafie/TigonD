FROM python:3.12-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY migrations ./migrations
COPY alembic.ini .

EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && python -c 'from app.main import secret_store; secret_store.ensure_mount()' && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
