{
  "realm": "tigond",
  "enabled": true,
  "roles": {"realm": [
    {"name": "administrator"}, {"name": "developer"}, {"name": "operator"},
    {"name": "quality"}, {"name": "governance"}
  ]},
  "clients": [{
    "clientId": "tigond-ui", "publicClient": true, "standardFlowEnabled": true,
    "directAccessGrantsEnabled": true,
    "redirectUris": ["http://localhost:3000/*", "http://localhost:4173/*"],
    "webOrigins": ["http://localhost:3000", "http://localhost:4173"],
    "protocolMappers": [{
      "name": "tigond-api-audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "config": {
        "included.client.audience": "tigond-ui",
        "access.token.claim": "true",
        "id.token.claim": "false"
      }
    }]
  }],
  "users": [{
    "username": "admin", "enabled": true,
    "credentials": [{"type": "password", "value": "ChangeMe123!", "temporary": true}],
    "realmRoles": ["administrator", "developer", "operator", "quality", "governance"]
  }]
}
