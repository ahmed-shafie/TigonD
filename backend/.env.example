TIGOND_CREDENTIAL_KEY=
TIGOND_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173
TIGOND_QUERY_TIMEOUT_SECONDS=15
TIGOND_PROFILE_SAMPLE_ROWS=10000
TIGOND_METADATA_DATABASE_URL=postgresql://tigond_meta:tigond_meta@metadata-db:5432/tigond_metadata
TIGOND_VAULT_URL=http://vault:8200
TIGOND_VAULT_TOKEN=tigond-dev-root
TIGOND_VAULT_MOUNT=tigond
TIGOND_KEYCLOAK_URL=http://keycloak:8080
TIGOND_KEYCLOAK_REALM=tigond
TIGOND_KEYCLOAK_CLIENT_ID=tigond-ui
# Audience claim required in access tokens. Defaults to the client id.
TIGOND_KEYCLOAK_AUDIENCE=tigond-ui
TIGOND_AUTH_DISABLED=false
TIGOND_NIFI_URL=http://nifi:8080/nifi-api
TIGOND_NIFI_USERNAME=
TIGOND_NIFI_PASSWORD=
TIGOND_NIFI_VERIFY_SSL=false
TIGOND_OLLAMA_URL=http://localhost:11434
TIGOND_OLLAMA_MODEL=qwen2.5:3b
TIGOND_OLLAMA_ENABLED=false
